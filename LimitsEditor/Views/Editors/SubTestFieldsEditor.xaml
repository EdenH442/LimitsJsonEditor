<UserControl x:Class="LimitsEditor.Views.Editors.SubTestFieldsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:LimitsEditor.Models"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid IsEnabled="{Binding HasEditableLimit}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Visibility="{Binding IsSubTestItemSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="132" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sub-Test Name" />
            <TextBox Grid.Row="0"
                     Grid.Column="2"
                     Text="{Binding EditableLimit.MultipleStepNameCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
            <TextBlock Grid.Row="2"
                       Grid.Column="2"
                       Foreground="IndianRed"
                       Style="{StaticResource SubtleTextStyle}"
                       Text="{Binding CurrentSubTestNameError}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="132" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Limit Type" />
            <ComboBox Grid.Row="0"
                      Grid.Column="2"
                      ItemsSource="{Binding AvailableLimitTypes}"
                      SelectedItem="{Binding EditableLimit.LimitType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2"
                       Grid.Column="2"
                       Foreground="IndianRed"
                       Style="{StaticResource SubtleTextStyle}"
                       Text="{Binding CurrentLimitTypeError}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Comparison">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EditableLimit.LimitType}" Value="{x:Static models:LimitType.Comparison}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ComboBox Grid.Row="4"
                      Grid.Column="2"
                      DisplayMemberPath="DisplayText"
                      ItemsSource="{x:Static models:ComparisonTypeOption.All}"
                      SelectedValue="{Binding EditableLimit.ComparisonType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Code">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EditableLimit.LimitType}" Value="{x:Static models:LimitType.Comparison}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>
            <TextBlock Grid.Row="6"
                       Grid.Column="2"
                       Foreground="IndianRed"
                       Style="{StaticResource SubtleTextStyle}"
                       Text="{Binding CurrentComparisonTypeError}" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Threshold Type" />
            <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding EditableLimit.ThresholdType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Expected" />
            <TextBox Grid.Row="10" Grid.Column="2" Text="{Binding EditableLimit.ExpectedRes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />

            <TextBlock Grid.Row="12" Grid.Column="0" Text="Low" />
            <TextBox Grid.Row="12" Grid.Column="2" Text="{Binding EditableLimit.Low, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
            <TextBlock Grid.Row="14"
                       Grid.Column="2"
                       Foreground="IndianRed"
                       Style="{StaticResource SubtleTextStyle}"
                       Text="{Binding CurrentResultError}" />

            <TextBlock Grid.Row="16" Grid.Column="0" Text="High" />
            <TextBox Grid.Row="16" Grid.Column="2" Text="{Binding EditableLimit.High, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />

            <TextBlock Grid.Row="18" Grid.Column="0" Text="Unit" />
            <TextBox Grid.Row="18" Grid.Column="2" Text="{Binding EditableLimit.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
            <TextBlock Grid.Row="20"
                       Grid.Column="2"
                       Foreground="IndianRed"
                       Style="{StaticResource SubtleTextStyle}"
                       Text="{Binding CurrentRangeError}" />
        </Grid>
    </Grid>
</UserControl>
